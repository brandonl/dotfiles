# Machine-specific zsh overrides (see zsh/99-local.zsh.example)
zsh/99-local.zsh

# Machine-specific Homebrew packages/taps
Brewfile.local

# Legacy brew bundle snapshot; install always upgrades to latest
Brewfile.lock.json

# APM installed dependencies
/apm/**/apm_modules/

# Machine/work-specific global APM dependencies and their combined lockfile
/apm/global/apm.local.yml
/apm/global/apm.local.lock.yaml

# Override the global settings.json ignore for portable Zed settings.
!/config/zed/settings.json

# Override the global settings.json ignore for portable VSCodium settings.
!/vscodium/settings.json
