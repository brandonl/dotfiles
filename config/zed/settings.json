// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "csv": true,
    "dockerfile": true,
    "html": true,
    "make": true,
    "mcp-server-figma": true,
    "one-dark-pro": true,
    "rainbow-csv": true,
    "ruby": true,
    "snazzy": true,
    "tokyo-night": true
  },
  "cli_default_open_behavior": "existing_window",
  "toolbar": {
    "agent_review": false
  },
  "diff_view_style": "unified",
  "context_servers": {
    "mcp-server-figma": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "default",
        "reasoning_effort": "low",
        "mode": "agent-full-access",
        "model": "gpt-5.6-sol"
      },
      "favorite_config_option_values": {
        "model": [
          "gpt-5.6-terra"
        ]
      },
      "type": "registry"
    }
  },
  "buffer_font_weight": 100.0,
  "icon_theme": "Catppuccin Macchiato",
  "agent": {
    "limit_content_width": false,
    "thinking_display": "always_collapsed",
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "dock": "left",
    "default_model": {
      "provider": "ollama",
      "model": "qwen3.6:latest",
      "enable_thinking": true
    },
    "enable_feedback": false,
    "favorite_models": [],
    "single_file_review": true,
    "model_parameters": []
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
    "show": true
  },
  "title_bar": {
    "show_user_picture": false,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
    "cursor_position_button": true,
    "active_language_button": true
  },
  "project_panel": {
    "dock": "right",
    "git_status_indicator": false,
    "auto_reveal_entries": true,
    "indent_size": 17.0,
    "button": true
  },
  "prettier": {
    "allowed": true
  },
  "cursor_shape": "bar",
  "text_rendering_mode": "platform_default",
  "buffer_line_height": "comfortable",
  "use_auto_surround": true,
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "preferred_line_length": 120,
  "scroll_sensitivity": 3.0,
  "horizontal_scroll_margin": 5.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "terminal": {
    "button": true,
    "font_size": 16.0
  },
  "show_whitespaces": "selection",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false,
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_fallbacks": [
    "Courier New",
    "monospace",
    "Jet Brains Mono"
  ],
  "buffer_font_family": "Monaco",
  "auto_indent_on_paste": true,
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "agent_ui_font_size": 22.0,
  "agent_buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
  "file_scan_exclusions": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/translations/**",
    "*.html"
  ]
}
