[user]
	name = Brandon🔥
	email = brandonluth@gmail.com

[github]
    user = brandonl

[alias]
    l = "!source ~/.githelpers && pretty_git_log"
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
    default-branch = "!git remote show origin | sed -n '/HEAD branch/s/.*: //p'"
    fetch-origin = "!git checkout $(git default-branch) && git fetch origin && git pull origin"
    fo = "fetch-origin"
    fetch-origin-prune = "!git fo && git trim --merged"
    fop = "fetch-origin-prune"
    # Don't use "git push -f" or "git push --force" they are not history-safe
    # instead always force push while using a history-lease
    # this forces you to make sure you have the latest remote history fetched before you can push and rewrite history
    # "git pushf" command can now be used
	pushf = push --force-with-lease

[branch]
    sort = -committerdate

[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto

[color "branch"]
    current = yellow reverse
    remote = green bold
    local = blue bold

[color "diff"]
    meta = blue bold
    frag = magenta bold
    old = red bold
    new = green bold

[diff]
    algorithm = histogram
    submodule = log
    colorMoved = default
    mnemonicPrefix = true
    renames = copies
    # difftastic swap-back:
    # tool = difftastic
    # external = difft

[difftool]
    prompt = false

[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[pager]
    difftool = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    hyperlinks = true
    # side-by-side off by default; toggle per-invocation with `gds` (see zsh utils)
    side-by-side = false

[maintenance]
    auto = true

[status]
    submoduleSummary = true

[submodule]
    recurse = true

[fetch]
    prune = true

[push]
    default = simple
    autoSetupRemote = true

[pull]
    default = current
    rebase = true

[commit]
    verbose = true

[rebase]
    autosquash = true
    autostash = true
    updateRefs = true

[column]
    ui = auto

[tag]
    sort = version:refname

[log]
    date = iso

[core]
    editor = vim
    excludesfile = ~/.gitignore
    pager = delta
	fsmonitor = false
    untrackedCache = true

[feature]
    manyFiles = true

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

# Tell git to always use ssh.
# TODO: Comment out when using xcode to avoid ssh key prompt
[url "git@github.com:"]
    insteadOf = https://github.com/
    insteadOf = git://github.com/
    insteadOf = git+https://github.com/
    insteadOf = git+git://github.com/

[init]
	templatedir = ~/.git-templates
	defaultBranch = main

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[help]
    autocorrect = prompt
